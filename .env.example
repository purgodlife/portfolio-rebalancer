# 이 파일을 복사해서 .env.local로 만들고 값을 채우세요 (.env.local은 git에 커밋되지 않습니다).
# 값은 전부 광고 단위/클라이언트 "ID"일 뿐 비밀값이 아닙니다(어차피 페이지 소스에 그대로 노출됩니다).
# 아무 값도 채우지 않으면 광고 영역은 그냥 아무것도 표시되지 않습니다(빌드/배포에는 영향 없음).

# 배포된 실제 주소(예: https://내사이트.vercel.app). sitemap.xml, robots.txt,
# Open Graph 링크에 쓰입니다. 로컬 개발 중에는 안 채워도 됩니다.
NEXT_PUBLIC_SITE_URL=

# 구글 서치콘솔(search.google.com/search-console) "HTML 태그" 소유확인 방식에서
# 주는 content="" 안의 값만 넣으세요(태그 전체 아님).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저(searchadvisor.naver.com) 소유확인 값.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 카카오 애드핏(https://adfit.kakao.com) 광고 단위 등록 후 발급되는 값(데스크톱, md 이상에서만 표시)
NEXT_PUBLIC_KAKAO_ADFIT_UNIT=
NEXT_PUBLIC_KAKAO_ADFIT_WIDTH=728
NEXT_PUBLIC_KAKAO_ADFIT_HEIGHT=90

# 카카오 애드핏 모바일 전용 광고 단위(선택, md 미만에서 표시). 애드핏은 지정한
# 픽셀 크기 그대로 렌더링되고 화면폭에 맞춰 자동으로 줄어들지 않으므로, 위
# 728x90 데스크톱 배너를 모바일에 그대로 쓰면 가로 스크롤이 생깁니다. 애드핏
# 대시보드에서 모바일 배너(보통 320x50) 단위를 따로 만들어 여기 넣으세요.
# 비워두면 모바일 화면에서는 광고가 표시되지 않습니다(레이아웃 깨짐 방지).
NEXT_PUBLIC_KAKAO_ADFIT_UNIT_MOBILE=
NEXT_PUBLIC_KAKAO_ADFIT_WIDTH_MOBILE=320
NEXT_PUBLIC_KAKAO_ADFIT_HEIGHT_MOBILE=50

# 구글 애드센스(https://adsense.google.com) 사이트 승인 후 발급되는 값
# 둘 다 있어야 표시됩니다. 카카오 애드핏 값이 같이 설정돼 있으면 애드핏이 우선 표시됩니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
